{
  "name": "@kyuri-metro/shmetro-line-id-block-generator",
  "version": "1.0.2",
  "description": "一个在浏览器中运行的工具，用于生成上海地铁风格的线路号方块 SVG 图形。",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "unpkg": "./dist/bundle.js",
  "jsdelivr": "./dist/bundle.js",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./dist/bundle.js": "./dist/bundle.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README.zh-CN.md"
  ],
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/opentype.js": "^1.3.8",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "opentype.js": "^1.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "vite",
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "npm run build:package && npm run build:web",
    "build:package": "vite build --mode package && tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "preview": "vite preview",
    "prepublishOnly": "npm run build:package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unnamed2964/kyuri-shmetro-line-id-block-generator.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Unnamed2964/kyuri-shmetro-line-id-block-generator/issues"
  },
  "homepage": "https://github.com/Unnamed2964/kyuri-shmetro-line-id-block-generator#readme",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@umamichi-ui/common-css": "^0.1.6"
  }
}
